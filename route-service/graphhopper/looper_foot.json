// Looper's own walking profile, replacing GraphHopper's bundled foot.json.
//
// The stock profile multiplies every edge's priority by `foot_priority`, an
// OSM-derived score built mostly from road class and sidewalk tags. For a
// loop generator aiming candidates in many directions, that meant every
// route funnelled onto the same "well-tagged" arterial roads regardless of
// bearing. The one road-class distinction that matters to Looper is a
// dedicated pedestrian way: when OSM maps a pavement separately, keep the
// walker on it rather than hopping between it and the carriageway. This
// profile therefore keeps the real constraints (impassable, dangerous
// terrain, private access), treats ordinary roads alike, and strongly
// prefers dedicated pedestrian infrastructure.
{
  "priority": [
    { "if": "!foot_access || hike_rating >= 2", "multiply_by": "0" },
    { "if": "country == DEU && road_class == BRIDLEWAY && foot_road_access != YES", "multiply_by": "0" },
    { "if": "mtb_rating > 3", "multiply_by": "0.7" },
    { "if": "foot_road_access == PRIVATE", "multiply_by": "0.1" },
    // A separately mapped pavement is normally a FOOTWAY. PATH, PEDESTRIAN
    // and STEPS are also dedicated pedestrian links, so leave their priority
    // intact. Reducing every other usable road makes a parallel pavement win
    // unless it would impose an exceptionally large detour.
    { "if": "road_class != FOOTWAY && road_class != PATH && road_class != PEDESTRIAN && road_class != STEPS", "multiply_by": "0.1" }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" }
  ]
}
