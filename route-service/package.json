{
  "name": "looper-route-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Looper's own loop-generation API. Owns the algorithm; GraphHopper is only the pedestrian pathfinder underneath.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@turf/area": "^7.2.0",
    "@turf/buffer": "^7.2.0",
    "@turf/circle": "^7.2.0",
    "@turf/difference": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/simplify": "^7.2.0",
    "@turf/union": "^7.2.0"
  },
  "devDependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
