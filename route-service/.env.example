# ---------------------------------------------------------------------------
# Looper — routing stack configuration
#
# There is no routing provider API key here and there should never be one:
# GraphHopper runs in our own container against our own OSM extract.
# ---------------------------------------------------------------------------

# --- OpenStreetMap data ----------------------------------------------------
# A file under ./data is used if present; otherwise the URL is downloaded once
# into the volume and reused. Point both at another Geofabrik extract to serve
# a different region — nothing else in the stack is Isle of Man specific.
OSM_PBF_IOM_PATH=isle-of-man-latest.osm.pbf
OSM_PBF_IOM_URL=https://download.geofabrik.de/europe/isle-of-man-latest.osm.pbf
OSM_PBF_ENGLAND_PATH=england-latest.osm.pbf
OSM_PBF_ENGLAND_URL=https://download.geofabrik.de/europe/united-kingdom/england-latest.osm.pbf

# --- GraphHopper -----------------------------------------------------------
GRAPHHOPPER_VERSION=11.0
GRAPHHOPPER_PROFILE=foot
# Import needs the most memory. 2g is comfortable for a country-sized extract.
GH_IOM_HEAP=2g
GH_ENGLAND_HEAP=6g
# Local debugging only; the production stack does not publish this port.
GRAPHHOPPER_PORT=8989

# --- Looper route service --------------------------------------------------
ROUTE_SERVICE_PORT=8988
# Comma-separated allowed browser origins. Use the PWA's own origin in
# production; `*` is convenient locally and wrong anywhere else.
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=info

# --- Algorithm feature flags -----------------------------------------------
# Every significant change to how loops are found has its own switch, and each
# one is set here to what actually ships. Turning two unproven ones on together
# produces a regression nobody can attribute to either, so change one at a
# time and re-run `npm run bench` in route-service.
#
# Anything but `true`/`1` leaves a flag as it ships: a typo means "the
# algorithm I already had", never "an unproven one, silently".
#
# On by default — measured wins, see route-service/docs/routing-report.md:
LOOPER_EDGE_OVERLAP=true            # measure retracing on network edges, not by proximity
LOOPER_SPREAD_BEARINGS=true         # dispatch candidate bearings spread round the compass
LOOPER_WAYPOINT_BACKBONE=true       # build waypoint walks from an ordered backbone
LOOPER_PULLBACK_TURN_ONLY=true      # don't undo two legs for a branch that gets trimmed anyway
LOOPER_BUDGET_DETOUR_GATE=true      # only reroute an over-long leg that actually detoured
#
# A quarter fewer engine calls, at the cost of about one walk in twenty and
# some separation between the ones that remain. Try it and measure with
# route-service/bench/probe-production.sh before deciding.
LOOPER_NARROW_CORNER_SWEEP=false    # try only the two loop shapes that usually work
LOOPER_PROGRESSIVE_CORNER_SWEEP=false  # sweep loop shapes across the whole batch, not inside each candidate
#
# Repairs a guide point that landed in a cul-de-sac, the same way the ring
# builder repairs a corner that did. Eliminated U-turn rejections entirely on
# the fixtures and cut suburban waypoint requests from 589 calls to 42 — but
# left one walk offered there where the slower path found three. A genuine
# trade; turn it on and compare with bench/probe-production.sh.
LOOPER_GUIDE_POINT_PULLBACK=false   # move a dead-ended guide point (never a pin)
#
# Off by default — implemented and tested, not yet earned. See the report for
# the evidence behind each:
LOOPER_DIVERSITY_EARLY_STOP=false   # +16% engine calls for negligible extra separation
LOOPER_PARETO_ARCHIVE=false         # correct and harmless; no measured benefit yet
LOOPER_LOCAL_REPAIR=false           # better candidate pool, worse offered separation
LOOPER_NETWORK_AWARE_SEEDS=false    # worth it for coastal regions; net 0.5% elsewhere
LOOPER_TWO_STAGE_SCREENING=false    # +37% path searches inside the engine for nothing
LOOPER_REQUEST_CACHE=false          # correct by construction; hit rate unmeasured

# --- Tuning ----------------------------------------------------------------
# CANDIDATE_COUNT=24
#
# How many of one walker's routing calls run at once. Measured against
# production on 2026-08-26: GraphHopper answers a foot leg in 30-65 ms, and a
# 5 km request spends 21 s of engine time compressed into 4.8 s of wall clock
# — an achieved parallelism of only 4.4 against this limit of 6. Raising it is
# the largest single lever on how long a walker waits, and it is a knob rather
# than an algorithm. Raise GRAPHHOPPER_MAX_CONCURRENCY with it, or two
# simultaneous walkers will saturate the global ceiling.
# ROUTING_CONCURRENCY=6
# GRAPHHOPPER_MAX_CONCURRENCY=24
# GRAPHHOPPER_MAX_QUEUE=100
# NETWORK_PROBE_TIMEOUT_MS=2500
# ROUTE_CACHE_MAX_ENTRIES=500
# ROUTE_CACHE_TTL_MS=600000
# ROUTE_CACHE_EMPTY_TTL_MS=60000
# Bump by hand whenever looper_foot.json is retuned: it invalidates every
# cached answer generated under the old model.
# GRAPHHOPPER_PROFILE_VERSION=looper-foot-1
