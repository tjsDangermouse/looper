# ---------------------------------------------------------------------------
# Looper — routing stack configuration
#
# There is no routing provider API key here and there should never be one:
# GraphHopper runs in our own container against our own OSM extract.
# ---------------------------------------------------------------------------

# --- OpenStreetMap data ----------------------------------------------------
# A file under ./data is used if present; otherwise the URL is downloaded once
# into the volume and reused. Point both at another Geofabrik extract to serve
# a different region — nothing else in the stack is Isle of Man specific.
OSM_PBF_IOM_PATH=isle-of-man-latest.osm.pbf
OSM_PBF_IOM_URL=https://download.geofabrik.de/europe/isle-of-man-latest.osm.pbf
OSM_PBF_ENGLAND_PATH=england-latest.osm.pbf
OSM_PBF_ENGLAND_URL=https://download.geofabrik.de/europe/united-kingdom/england-latest.osm.pbf

# --- GraphHopper -----------------------------------------------------------
GRAPHHOPPER_VERSION=11.0
GRAPHHOPPER_PROFILE=foot
# Import needs the most memory. 2g is comfortable for a country-sized extract.
GH_IOM_HEAP=2g
GH_ENGLAND_HEAP=6g
# Local debugging only; the production stack does not publish this port.
GRAPHHOPPER_PORT=8989

# --- Looper route service --------------------------------------------------
ROUTE_SERVICE_PORT=8988
# Comma-separated allowed browser origins. Use the PWA's own origin in
# production; `*` is convenient locally and wrong anywhere else.
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=info

# --- Front end (Vite, build time) ------------------------------------------
# Where the PWA should send POST /v1/loops. Leave blank for local development:
# the Vite dev server proxies /v1 to ROUTE_SERVICE_PORT.
VITE_LOOPER_API_BASE=
